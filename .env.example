# ============================================================
# AI Conflict Analyzer - Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# LLM Provider: "ollama" (local) | "openai" | "custom" (Groq)
LLM_PROVIDER=ollama

# --- Ollama (local, gratis) - https://ollama.com ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- OpenAI ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# --- Groq (cloud) - https://console.groq.com ---
# LLM_PROVIDER=custom
# CUSTOM_LLM_URL=https://api.groq.com/openai/v1
# CUSTOM_LLM_KEY=gsk_...
# CUSTOM_LLM_MODEL=llama-3.3-70b-versatile

# --- Backend server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- Plugin config ---
ACA_BACKEND_URL=http://localhost:8000
