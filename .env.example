# ============================================================
# AI Conflict Analyzer - Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# LLM Provider: "openai" | "ollama" | "custom"
LLM_PROVIDER=ollama

# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# --- Ollama (local, free) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# --- Custom OpenAI-compatible endpoint (LM Studio, Groq, etc.) ---
CUSTOM_LLM_URL=http://localhost:1234/v1
CUSTOM_LLM_KEY=
CUSTOM_LLM_MODEL=mistral

# --- Backend server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- Plugin config ---
ACA_BACKEND_URL=http://localhost:8000
